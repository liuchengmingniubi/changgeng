extends RefCounted
const TASKS = [{"id": "c01", "title": "门槛边的甲壳虫", "owner": "guard_day", "tier": 1, "story": "换班的人还没吃饭，关外门槛边的虫群却又聚起来了。", "kind": "kill", "needs": {"甲壳虫": 3}, "ending": "门口清净了，换班的人终于能坐下吃顿饭。你也去歇歇，别替我把两班都站了。"}, {"id": "c02", "title": "给晚归的人留一口热饭", "owner": "innkeeper", "tier": 1, "story": "脚夫总说不饿。芸娘想留两只热馒头，又不愿伤他的体面。", "kind": "deliver", "needs": {"馒头": 2}, "ending": "我就说今天多蒸了两个。他肯接过来，比听见一句谢还让人放心。"}, {"id": "c03", "title": "磨盘不能空着等", "owner": "farmer", "tier": 1, "story": "邻家麦袋见了底，满仓想先替他们磨上一小袋。", "kind": "deliver", "needs": {"沙麦": 3}, "ending": "这点麦我先磨了送去。不挂账，等他们自家收成好了，再帮旁人就是。"}, {"id": "c04", "title": "炉边的小试样", "owner": "smith", "tier": 1, "story": "郭成想试一片新护边；合不合用，得先在炉旁敲过。", "kind": "deliver", "needs": {"甲壳": 2}, "ending": "甲片边上有一道韧纹，我得再试试。做甲护的是人，不能只看着结实。"}, {"id": "c05", "title": "灯下的一碗面", "owner": "guard_night", "tier": 1, "story": "夜里守门的人不说冷，只问还有没有一口热汤。", "kind": "deliver", "needs": {"面条": 1}, "ending": "面还热着。我替下一班也留一口汤，夜长，空着肚子难熬。"}, {"id": "c06", "title": "备用绑带", "owner": "scout", "tier": 1, "story": "韩守义出关前总要摸一遍绑带，旧习惯救过人。", "kind": "deliver", "needs": {"皮革": 1, "粗布": 1}, "ending": "备用的，最好一辈子用不上。可出关的人，不能拿最好两个字赌命。"}, {"id": "c07", "title": "少一口，也得吃饭", "owner": "medic", "tier": 1, "story": "军医替别人叮嘱了半日，自己的饭却一口没动。", "kind": "deliver", "needs": {"馒头": 1}, "ending": "你把我的话还给我了。行，我先吃，药方等这一口咽下去再写。"}, {"id": "c08", "title": "账本上的小圆点", "owner": "merchant", "tier": 1, "story": "账本上的圆点不是欠钱，是康裕替不识字的老人记下的种子。", "kind": "deliver", "needs": {"初始种子": 2}, "ending": "圆点擦去了，种子不催还。人记得这份好，账本就没白写。"}, {"id": "c09", "title": "自家门前那一畦", "owner": "elder", "tier": 1, "story": "田伯说，守村子的孩子，也该照料好自家那畦地。", "kind": "harvest", "needs": {"沙麦": 3}, "ending": "我看见你照料那畦地了。人往远处走，也得知道回家能做点什么。", "hand_in": {"沙麦": 1}}, {"id": "c10", "title": "缝线下的软衬", "owner": "leather", "tier": 1, "story": "冯厚嫌护具磨人，却又不肯让人知道自己连夜拆了重缝。", "kind": "deliver", "needs": {"粗布": 2}, "ending": "软衬在里头，别人看不见。穿的人不疼，比夸我手艺好有用。"}, {"id": "c11", "title": "白日巡防的缺口", "owner": "captain", "tier": 2, "story": "人手不够，裴肃把缺口记在自己的巡防册上。", "kind": "kill", "needs": {"甲壳虫": 6}, "ending": "巡册这个缺口补上了。功劳写你的，漏巡的责我自己记着。"}, {"id": "c12", "title": "饭桌上多摆两只碗", "owner": "innkeeper", "tier": 2, "story": "有些客人怕欠人情。芸娘说，今天只是多煮了一锅。", "kind": "deliver", "needs": {"面条": 2, "馒头": 2}, "ending": "多摆两双筷子，谁也不用问为什么。吃完帮我收碗，就算还了人情。"}, {"id": "c13", "title": "旧甲也值得修", "owner": "smith", "tier": 2, "story": "旧甲挡过刀，郭成不肯只因难看就把它扔进废铁堆。", "kind": "deliver", "needs": {"铁锭": 2, "甲壳": 3}, "ending": "旧甲还得再铆一遍。他舍不得的是同袍留下的痕，不是这几块铁。"}, {"id": "c14", "title": "药箱里不能只剩空位", "owner": "medic", "tier": 2, "story": "上一班巡卒没有用上药，不等于下一班也不需要。", "kind": "deliver", "needs": {"回血药水": 1}, "ending": "药箱有了余量，我也能少说一句省着用。药是救人的，不该让人舍不得。"}, {"id": "c15", "title": "不肯涨价的一袋面", "owner": "merchant", "tier": 2, "story": "康裕算得精，却不肯改掉先前答应穷客的旧价。", "kind": "deliver", "needs": {"面粉": 3}, "ending": "原价就是原价。做买卖有赚有赔，答应的话不能跟着粮价涨。"}, {"id": "c16", "title": "磨破的护具绑带", "owner": "scout", "tier": 2, "story": "老韩总给别人检查行装，自己的绑带却快断了。", "kind": "deliver", "needs": {"皮革": 2, "粗布": 1}, "ending": "你倒学会查我的行装了。好事，以后见着不妥，别怕我年纪大。"}, {"id": "c17", "title": "换班之前清一遍", "owner": "guard_day", "tier": 2, "story": "卫迟怕同袍在疲乏时被虫群堵住回关的路。", "kind": "kill", "needs": {"甲壳虫": 5}, "ending": "他们能从这条路回来吃口热饭，今天的巡防就算有个着落。"}, {"id": "c18", "title": "留下种，才有下一季", "owner": "farmer", "tier": 2, "story": "借出去的粮暂且不催，播种的时节可不能耽误。", "kind": "deliver", "needs": {"沙麦": 5, "初始种子": 2}, "ending": "种子先送去，粮再慢慢补。人饿一顿还能撑，地误一季就难补了。"}, {"id": "c19", "title": "不是谁都肯说疼", "owner": "doctor", "tier": 2, "story": "病人嘴上说没事，许素问却看见他握碗的手在抖。", "kind": "deliver", "needs": {"基础草药": 2}, "ending": "药我替他收下。下回你见他，只问饭好不好吃，别当众问他疼不疼。"}, {"id": "c20", "title": "门边那碗凉饭", "owner": "soldier", "tier": 2, "story": "大川换班时跑得急，回来才发现饭已凉透。", "kind": "deliver", "needs": {"草药饼": 1, "馒头": 2}, "ending": "我本想说不饿……闻到味儿就装不下去了。谢谢，换班后我会记着吃。"}, {"id": "c21", "title": "顶在路中央的硬壳", "owner": "captain", "tier": 3, "story": "辎重车绕路会误时，裴肃也不愿让车夫冒险硬闯。", "kind": "kill", "needs": {"厚甲甲壳虫": 2}, "ending": "车夫不用绕了。路清出来是大家的事，不能让最没甲的人走在前头。"}, {"id": "c22", "title": "再试一次的甲片", "owner": "smith", "tier": 3, "story": "第一片护甲有裂纹。郭成宁可白费工夫，也不肯交出去。", "kind": "deliver", "needs": {"厚甲片": 2}, "ending": "这片能用，但我还得再试一遍。少一条裂，才算对得起这份工钱。"}, {"id": "c23", "title": "军需不能只够今天", "owner": "medic", "tier": 3, "story": "药箱填满并非图个心安，是替下一次归来留条路。", "kind": "deliver", "needs": {"回血药水": 2, "皮革": 1}, "ending": "备用格填上了。没人用它最好；真要用时，我也能抬头说还有。"}, {"id": "c24", "title": "留给别人家的麦种", "owner": "farmer", "tier": 3, "story": "满仓留了来年的种，也想替迟迟没动静的邻家留一份。", "kind": "deliver", "needs": {"沙麦": 8, "初始种子": 3}, "ending": "给邻家那份我单独收着。门还锁着，季节可不等人。"}, {"id": "c25", "title": "结实也要合身", "owner": "leather", "tier": 3, "story": "护具若勒得人抬不起手，再结实也护不了人。", "kind": "deliver", "needs": {"皮革": 3, "粗布": 2}, "ending": "我拆了两回才合身。做护具不是把人勒成一个模样，是让他还能抬手。"}, {"id": "c26", "title": "卖不出去的承诺", "owner": "merchant", "tier": 3, "story": "商队迟了，康裕还是答应按原价备好他们的干粮。", "kind": "deliver", "needs": {"面粉": 5, "馒头": 3}, "ending": "东西齐了，答应车队的旧价也照算。少赚的这一笔，我自己担。"}, {"id": "c27", "title": "蝎尾不能留在路口", "owner": "guard_day", "tier": 3, "story": "卫迟看见车辙旁的毒痕，怕有人天黑后经过。", "kind": "kill", "needs": {"沙蝎": 4}, "ending": "路口毒痕清了，我去加个灯标。能绕开危险，比忍着疼回来强。"}, {"id": "c28", "title": "有壳，也得有办法", "owner": "smith", "tier": 3, "story": "郭成要找出蝎壳的韧处，免得做成一碰就裂的空架子。", "kind": "deliver", "needs": {"蝎壳": 3, "蝎尾": 1}, "ending": "壳硬不等于哪儿都硬。找到韧处，才不至于让穿甲的人替我试错。"}, {"id": "c29", "title": "带回来的是消息，也是人", "owner": "scout", "tier": 3, "story": "老韩要的不是好看的战报，而是巡路的人能平安回来。", "kind": "kill", "needs": {"甲壳虫": 5, "厚甲甲壳虫": 1}, "ending": "你回来了，先坐。战报等气喘匀了再说，我先把人数点齐。"}, {"id": "c30", "title": "长夜也要有人吃饱", "owner": "guard_night", "tier": 3, "story": "段宁不爱多话，却记着夜班每个人的饭量。", "kind": "deliver", "needs": {"面条": 3, "草药饼": 2}, "ending": "这些够分到换班了。你那份在灶边，不许只管别人。"}, {"id": "c31", "title": "洞口上方的黑影", "owner": "captain", "tier": 3, "story": "洞口的蝠群遮住视线，先把探路的退路清出来。", "kind": "kill", "needs": {"蝙蝠": 6}, "ending": "洞口能看清些了。我会让探路的人记住：看见路，也得留住退路。"}, {"id": "c32", "title": "药包背面的新针脚", "owner": "medic", "tier": 3, "story": "军医把药包翻过来缝，旧针脚里还夹着沙。", "kind": "deliver", "needs": {"蝠翼": 3, "皮革": 2}, "ending": "新针脚还歪着，但药包不会漏了。人手抖的时候，东西得靠得住。"}, {"id": "c33", "title": "岩背之后的空路", "owner": "guard_day", "tier": 3, "story": "碎石坡上挤着岩背蜥，卫迟担心有人失足。", "kind": "kill", "needs": {"岩背蜥": 3}, "ending": "坡上的路腾出来了。下回见着挑担的人，提醒一句就好，别吓他们。"}, {"id": "c34", "title": "不肯交出的次品", "owner": "smith", "tier": 3, "story": "郭成把次品藏在炉边，怕学徒舍不得材料又拿去用。", "kind": "deliver", "needs": {"岩鳞": 3, "铁锭": 2}, "ending": "料我收下。次品还在炉旁留着，叫学徒看看错在哪儿，比藏起来有用。"}, {"id": "c35", "title": "风起前的一次清理", "owner": "scout", "tier": 3, "story": "风起后看不清脚下，老韩想先把退路走稳。", "kind": "kill", "needs": {"沙蝎": 4, "厚甲甲壳虫": 2}, "ending": "风还没起来，你已经回来了。记着今天这条路，往后领人也得领得回来。"}, {"id": "c36", "title": "灯照不到的地方", "owner": "guard_night", "tier": 3, "story": "灯能照出洞口，却照不到头顶悄悄靠近的蝠群。", "kind": "kill", "needs": {"蝙蝠": 8}, "ending": "灯我去添。你清出来的空当，得让下一班看得见才算数。"}, {"id": "c37", "title": "把备用补给补齐", "owner": "captain", "tier": 3, "story": "裴肃把备用两字写得很重，他不想再临时去借。", "kind": "deliver", "needs": {"回血药水": 3, "草药饼": 3, "皮革": 2}, "ending": "补给齐了，我把备用两字划去。缺什么记什么，不能等出关才发现。"}, {"id": "c38", "title": "难做的衬边", "owner": "leather", "tier": 3, "story": "硬鳞与软皮接缝难做，冯厚宁可多试几次。", "kind": "deliver", "needs": {"岩鳞": 2, "皮革": 3, "粗布": 2}, "ending": "这道衬边总算不硌手了。做在里头的工夫，也不能马虎。"}, {"id": "c39", "title": "清净一点，才能听清", "owner": "captain", "tier": 3, "story": "洞边的怪声混着蝠鸣，先清理周围再听动静。", "kind": "kill", "needs": {"蝙蝠": 5, "沙蝎": 3}, "ending": "能听清些了，消息我会另派人核查。别让一声怪响就把人都引进去。"}, {"id": "c40", "title": "胆小的人也能守住位置", "owner": "soldier", "tier": 3, "story": "大川承认自己怕，但他还是想守好交给自己的位置。", "kind": "kill", "needs": {"厚甲甲壳虫": 2, "岩背蜥": 2}, "ending": "我还是怕。可今天有人替我清路，明天轮到我值守，我也得站住。", "hand_in": {"馒头": 1}}]
const WARRANTS = [{"id": "w1", "title": "堵路的铁背", "owner": "guard_day", "tier": 4, "story": "辎重车已绕了两次路。卫迟要清出通道，也不许车夫再冒险硬闯。", "kind": "elite", "needs": {"铁背甲壳虫": 1}, "base": "厚甲甲壳虫", "hp": 280, "ending": "车能直着走了，我也能让车夫歇一会。你清的是路，不是给人逞强的机会。"}, {"id": "w2", "title": "粮袋上的破洞", "owner": "merchant", "tier": 4, "story": "康裕错怪了搬粮的脚夫。查明虫患后，他想把扣下的饭钱连同赔礼一起还回去。", "kind": "elite", "needs": {"噬粮甲壳虫": 1}, "base": "甲壳虫", "hp": 220, "ending": "饭钱我已经补给他了，赔礼也当面说。记错一笔账能改，错怪一个人更得改。"}, {"id": "w3", "title": "断尾仍有毒", "owner": "farmer", "tier": 4, "story": "粮袋可以再缝，路过的人却不能中毒。满仓宁肯少收一袋粮。", "kind": "elite", "needs": {"断尾沙蝎": 1}, "base": "沙蝎", "hp": 320, "ending": "退路清出来了。这份工钱请收好，你的平安也算在这次回报里。"}, {"id": "w4", "title": "洞口的尖啸", "owner": "captain", "tier": 4, "story": "尖啸盖过洞里的声音，裴肃不愿让探路的人听不见同袍的呼喊。", "kind": "elite", "needs": {"尖啸蝠": 1}, "base": "蝙蝠", "hp": 300, "ending": "退路清出来了。这份工钱请收好，你的平安也算在这次回报里。"}, {"id": "w5", "title": "碎石坡上的岩背", "owner": "scout", "tier": 4, "story": "老韩在旧图上圈了退路。路窄，容不得伤员再被逼回洞口。", "kind": "elite", "needs": {"裂鳞岩背蜥": 1}, "base": "岩背蜥", "hp": 400, "ending": "退路清出来了。这份工钱请收好，你的平安也算在这次回报里。"}, {"id": "w6", "title": "熄灯的黑翼", "owner": "guard_night", "tier": 4, "story": "段宁补了三次灯。他担心的不是灯油，是下一班人找不到回去的路。", "kind": "elite", "needs": {"黑翼蝠": 1}, "base": "蝙蝠", "hp": 360, "ending": "退路清出来了。这份工钱请收好，你的平安也算在这次回报里。"}]
