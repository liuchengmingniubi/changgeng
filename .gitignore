# ---- Godot ----
# 引擎二进制不入库（132MB，由 INSTALL.txt 单独分发）
engine/
# 编辑器导入缓存，可随时重建
.godot/
# 导出产物
build/
*.exe
*.pck
!engine/*.exe

# ---- 测试与运行时产物 ----
_userdata/
tests/_logs/
*.tmp

# ---- 系统 ----
Thumbs.db
desktop.ini
.DS_Store

# 本地调试用户目录（旧做法）
.godot-user/

# 字体原子写入残渣
assets/.font.otf.*

# Python 缓存
__pycache__/
*.pyc
